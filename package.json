{
  "private": true,
  "name": "@gjbkz/360image",
  "type": "module",
  "scripts": {
    "lint": "eslint src build",
    "test": "run-s test:*",
    "test:type": "tsc --noEmit",
    "test:unit": "nlib-mts-test build src",
    "build": "run-s build:*",
    "build:main": "node --experimental-loader=@nlib/tsm build/main.mts",
    "start": "run-p start:*",
    "start:watch": "node --experimental-loader=@nlib/tsm build/main.mts --watch",
    "start:server": "sable docs",
    "postversion": "run-s postversion:*",
    "postversion:changelog": "npx @nlib/changelog -- --output CHANGELOG.md",
    "postversion:add": "git add .",
    "postversion:commit": "git commit --amend --no-edit"
  },
  "devDependencies": {
    "@material-design-icons/svg": "0.14.15",
    "@nlib/githooks": "0.2.2",
    "@nlib/tsm": "^0.1.0",
    "@nlib/typing": "1.1.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "lint-staged": "14.0.1",
    "npm-run-all": "4.1.5",
    "pannellum": "2.5.7",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recoil": "0.7.7",
    "sable": "0.6.0",
    "sass": "1.106.1",
    "styled-components": "6.6.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.*(m|c)+(j|t)s*(x)": "eslint"
  },
  "renovate": {
    "extends": [
      "github>nlibjs/renovate-config"
    ]
  }
}
